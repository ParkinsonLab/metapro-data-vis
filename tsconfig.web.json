{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "composite": true,
    "baseUrl": ".",
    "paths": { "@renderer/*": ["src/renderer/src/*"] },
    "types": ["vite/client"]
  },
  "include": ["src/renderer/src/**/*", "src/renderer/src/**/*.tsx"]
}
